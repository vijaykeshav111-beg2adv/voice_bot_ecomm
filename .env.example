# Add your own keys. Never share this file with real secrets.
GROQ_API_KEY=replace_with_your_groq_api_key
ELEVENLABS_API_KEY=replace_with_your_elevenlabs_api_key

# ---- Language model (Groq) ----
GROQ_MODEL=openai/gpt-oss-120b
# gpt-oss models only: low = fastest first word. medium/high think longer.
LLM_REASONING_EFFORT=low
LLM_MAX_TOKENS=400

# ---- Speech to text ----
# groq  = Groq-hosted Whisper (fast, accurate for Hindi). Falls back to local automatically if it fails.
# local = faster-whisper on this PC's CPU (slower).
STT_BACKEND=groq
GROQ_STT_MODEL=whisper-large-v3-turbo
# Used only when STT_BACKEND=local or as the fallback: tiny / base / small / medium
WHISPER_MODEL=base
# Leave empty to auto-detect, or force "hi" / "en" (forcing it is slightly faster and avoids wrong guesses)
WHISPER_LANGUAGE=
# Local Whisper speed settings (run `python bench_stt.py --record 5` to find the best values for YOUR PC)
# WHISPER_DEVICE: auto = use an NVIDIA GPU if one works, otherwise the CPU. Or force cpu / cuda.
WHISPER_DEVICE=auto
# WHISPER_THREADS: leave empty for about half your logical CPUs (4-8). Try 4, 6 or 8.
WHISPER_THREADS=
# WHISPER_VAD: 1 trims silence before transcribing. 0 is a little faster but may mis-hear silence.
WHISPER_VAD=1
# Seconds to wait for Groq speech-to-text before falling back to local Whisper.
GROQ_STT_TIMEOUT=8
# Optional, all off/unchanged by default. Only change them if `python bench_turns.py` shows a win on YOUR voice:
# GROQ_STT_RESPONSE_FORMAT=verbose_json   (json = smaller reply, but no detected-language field)
# GROQ_STT_PROMPT=                        (short vocabulary hint; can make Whisper invent text on silence)
# Load the local Whisper model in the background at startup so a Groq failure does not also pay the model load.
PRELOAD_LOCAL_FALLBACK=1

# ---- Text to speech (ElevenLabs) ----
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# eleven_flash_v2_5 = fastest, supports Hindi. eleven_multilingual_v2 = nicer voice but much slower.
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# Small files transfer faster. For higher quality try mp3_44100_64 or mp3_44100_128.
ELEVENLABS_OUTPUT_FORMAT=mp3_22050_32
# Sentences synthesised in parallel. Free plan allows 2 at once; paid plans allow more.
TTS_CONCURRENCY=2

# ---- Recording ----
RECORD_SECONDS=8
SAMPLE_RATE=16000
MAX_WEB_RECORD_SECONDS=30

# ==============================
# E-commerce demo store
# ==============================
# The tables are created automatically on first start. If this MySQL user may not CREATE DATABASE,
# create the database yourself first:  CREATE DATABASE voicebot CHARACTER SET utf8mb4;
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=replace_with_your_mysql_password
MYSQL_DATABASE=voicebot
MYSQL_POOL_SIZE=5

# 0 = turn booking off (plain voice chat bot again)
BOOKING_ENABLED=1
BUSINESS_NAME=Everyday Online Store
# Times below are wall-clock time in this timezone (needs the tzdata package on Windows).
BOOKING_TIMEZONE=Asia/Kolkata
OPEN_TIME=09:00
CLOSE_TIME=17:00
# Lunch break with no slots. Leave empty for none.
BREAK_TIME=13:00-14:00
SLOT_MINUTES=30
WORKING_DAYS=mon,tue,wed,thu,fri,sat
# Comma-separated dates with no slots, e.g. 2026-11-08,2026-12-25
HOLIDAYS=
# How far ahead people can book, and how soon before a slot booking closes.
BOOKING_DAYS_AHEAD=30
MIN_NOTICE_MINUTES=30
# Safety limit on LLM <-> database round trips within one reply.
MAX_TOOL_ROUNDS=4

# ==============================
# Deployment (see DEPLOY.md)
# ==============================
# Your domain name (its DNS "A" record must point to the server). Use "localhost" to try Docker on your own PC.
DOMAIN=localhost
# REQUIRED on a public server: protects administrative endpoints, cancelling and logs. Choose a long random value.
ADMIN_KEY=
# Without Docker: HOST=0.0.0.0 makes the server reachable from other machines (default 127.0.0.1 = this PC only)
HOST=127.0.0.1
PORT=8000

# ==============================
# RAG + MCP integration
# ==============================
# Local document folder for retrieval-augmented generation. No embedding/API key required.
# RAG_DOCS_DIR=knowledge_base
# MCP server name and transport (stdio is recommended for MCP clients).
MCP_SERVER_NAME=voicebot-ecommerce
MCP_TRANSPORT=stdio
